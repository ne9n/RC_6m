	)
	(text "USB-C VBUS charges the main battery (+BATT net) through U12. R11 sets ~100mA charge current (Ireg = 1000/R11[kOhm]); swap for ~2k if faster charging of a larger pack is needed. D1 lights while charging (STAT pulled low)."
		(exclude_from_sim no)
		(at 114.3 262.89 0)
